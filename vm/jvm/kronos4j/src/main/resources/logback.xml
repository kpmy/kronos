<configuration>

    <!-- Console Appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger Configuration (Baseline level for production is typically INFO) -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="inn.ocsf.kronos4j.vm.VirtualSerial" level="OFF" />

</configuration>
